@model List<PortfolioWebsite.Models.SkillViewModel>

@{
    var categoryIcons = new[]
    {
        "bi-code-slash",
        "bi-diagram-3",
        "bi-database",
        "bi-phone",
        "bi-tools",
        "bi-puzzle"
    };
}

<div class="row g-4">
    @for (var index = 0; index < Model.Count; index++)
    {
        var category = Model[index];
        <div class="col-md-6 col-lg-4">
            <article class="surface-card skill-card h-100" data-reveal>
                <div class="icon-box">
                    <i class="bi @categoryIcons[index % categoryIcons.Length]" aria-hidden="true"></i>
                </div>
                <h3 class="card-title-site">@category.Category</h3>
                <div class="chip-list">
                    @foreach (var skill in category.Skills)
                    {
                        <span class="tech-chip">@skill</span>
                    }
                </div>
            </article>
        </div>
    }
</div>
