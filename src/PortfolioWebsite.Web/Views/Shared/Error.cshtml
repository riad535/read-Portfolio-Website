@model ErrorViewModel

<section class="portfolio-section" aria-labelledby="error-title">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-6">
                <div class="surface-card text-center">
                    <div class="icon-box icon-box-center">
                        <i class="bi bi-exclamation-triangle" aria-hidden="true"></i>
                    </div>
                    <h1 id="error-title" class="section-title">Something went wrong</h1>
                    <p class="about-bio">
                        The page could not be loaded. Please try again or return to the home page.
                    </p>
                    @if (Model.ShowRequestId)
                    {
                        <p class="contact-detail-item">
                            <strong>Request ID:</strong> <code>@Model.RequestId</code>
                        </p>
                    }
                    <div class="hero-actions justify-content-center">
                        <a class="btn btn-gradient" asp-controller="Home" asp-action="Index">
                            <i class="bi bi-house" aria-hidden="true"></i>Back to home
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
