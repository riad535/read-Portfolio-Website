@inject IStaticContentProvider StaticContent
@{
    var brandName = StaticContent.GetStaticContent().Profile.FullName;
    var controller = ViewContext.RouteData.Values["controller"] as string;
    var successMessage = TempData["SuccessMessage"] as string;
    var errorMessage = TempData["ErrorMessage"] as string;

    string ActiveLink(string name) =>
        string.Equals(controller, name, StringComparison.OrdinalIgnoreCase) ? " is-active" : string.Empty;
}
<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>@ViewData["Title"] - Admin</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500&display=swap" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
</head>
<body class="admin-body">
    <div class="admin-shell">
        <div class="offcanvas-lg offcanvas-start admin-sidebar" tabindex="-1" id="adminSidebar" aria-labelledby="adminSidebarLabel">
            <div class="admin-sidebar-header">
                <span class="admin-brand" id="adminSidebarLabel">@brandName</span>
                <button type="button" class="admin-sidebar-close d-lg-none"
                        data-bs-dismiss="offcanvas" data-bs-target="#adminSidebar" aria-label="Close menu">
                    <i class="bi bi-x-lg" aria-hidden="true"></i>
                </button>
            </div>
            <div class="offcanvas-body admin-sidebar-body">
                <nav aria-label="Admin">
                    <ul class="admin-nav">
                        <li>
                            <a class="admin-nav-link@(ActiveLink("Dashboard"))"
                               asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                                <i class="bi bi-speedometer2" aria-hidden="true"></i>
                                <span>Dashboard</span>
                            </a>
                        </li>
                        <li>
                            <a class="admin-nav-link@(ActiveLink("Skills"))"
                               asp-area="Admin" asp-controller="Skills" asp-action="Index">
                                <i class="bi bi-lightning-charge" aria-hidden="true"></i>
                                <span>Skills</span>
                            </a>
                        </li>
                        <li>
                            <a class="admin-nav-link@(ActiveLink("Projects"))"
                               asp-area="Admin" asp-controller="Projects" asp-action="Index">
                                <i class="bi bi-folder2-open" aria-hidden="true"></i>
                                <span>Projects</span>
                            </a>
                        </li>
                        <li>
                            <a class="admin-nav-link@(ActiveLink("Experiences"))"
                               asp-area="Admin" asp-controller="Experiences" asp-action="Index">
                                <i class="bi bi-briefcase" aria-hidden="true"></i>
                                <span>Experience</span>
                            </a>
                        </li>
                    </ul>
                    <div class="admin-nav-divider" role="presentation"></div>
                    <ul class="admin-nav">
                        <li>
                            <a class="admin-nav-link" asp-area="" asp-controller="Home" asp-action="Index"
                               target="_blank" rel="noopener noreferrer">
                                <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i>
                                <span>View site</span>
                            </a>
                        </li>
                        <li>
                            <form asp-area="Admin" asp-controller="Account" asp-action="Logout" method="post" class="admin-logout-form">
                                <button type="submit" class="admin-nav-link admin-nav-button">
                                    <i class="bi bi-box-arrow-right" aria-hidden="true"></i>
                                    <span>Logout</span>
                                </button>
                            </form>
                        </li>
                    </ul>
                </nav>
            </div>
        </div>

        <div class="admin-main">
            <header class="admin-topbar">
                <button type="button" class="admin-menu-button d-lg-none"
                        data-bs-toggle="offcanvas" data-bs-target="#adminSidebar"
                        aria-controls="adminSidebar" aria-label="Open menu">
                    <i class="bi bi-list" aria-hidden="true"></i>
                </button>
                <h1 class="admin-page-title">@ViewData["Title"]</h1>
                <span class="admin-user-email">@User.Identity?.Name</span>
            </header>

            <main class="admin-content">
                <div class="admin-container">
                    @if (!string.IsNullOrWhiteSpace(successMessage))
                    {
                        <div class="alert admin-alert admin-alert--success" role="status" data-auto-dismiss="true">
                            <i class="bi bi-check-circle" aria-hidden="true"></i>
                            <span>@successMessage</span>
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(errorMessage))
                    {
                        <div class="alert admin-alert admin-alert--danger" role="alert">
                            <i class="bi bi-exclamation-triangle" aria-hidden="true"></i>
                            <span>@errorMessage</span>
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    @RenderBody()
                </div>
            </main>
        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/admin.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
